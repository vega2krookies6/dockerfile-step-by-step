# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요
# - 값에 따옴표("")나 공백을 넣지 마세요
# - $ 는 Compose가 변수로 해석하므로 비밀번호에 쓰지 마세요 (꼭 써야 하면 $$)
#
# 이 파일은 Compose에서 두 가지로 쓰입니다
# - mariadb 서비스: env_file: .env 로 전체 값을 전달
# - app 서비스: compose.yaml의 ${MARIADB_DATABASE} 같은 변수 자리에 값이 치환됨

# MariaDB root 비밀번호 (DB 관리용, 앱 컨테이너에는 전달되지 않음)
MARIADB_ROOT_PASSWORD=루트용_긴_비밀번호

# 처음 시작할 때 자동으로 만들어질 DB와 앱 전용 계정
# - db/init/01-revoke-drop.sql이 boot_db, boot 이름을 사용하므로 바꾸면 그 파일도 함께 수정
MARIADB_DATABASE=boot_db
MARIADB_USER=boot
MARIADB_PASSWORD=앱용_비밀번호
