# 이미지 빌드 시 복사하지 않을 파일

# 비밀 값
.env

# 빌드 결과물: 컨테이너 안에서 새로 빌드
target

# DB 초기화 스크립트: 앱 이미지가 아니라 MariaDB 컨테이너에 연결해서 사용
# (Flyway 마이그레이션은 src/main/resources/db/migration 에 있으므로 이것과 다름)
db

# Compose 설정 파일: 이미지 실행에 필요 없음
compose.yaml

# IntelliJ, VS Code 설정 파일
.idea
*.iml
.vscode

# Docker, 문서, 버전 관리 파일
Dockerfile
.dockerignore
실행방법.txt
README.md
.git
.gitignore
