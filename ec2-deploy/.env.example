# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요 (EC2 에서)
#   cp .env.example .env && chmod 600 .env && nano .env
# - 값에 따옴표("")나 공백을 넣지 마세요
# - $ 는 Compose 가 변수로 해석하므로 비밀번호에 쓰지 마세요 (꼭 써야 하면 $$)

# Docker Hub 아이디 (이미지 이름 앞부분)
DOCKERHUB_USERNAME=내_도커허브_아이디

# 사용할 이미지 태그 (GitHub Actions 가 v1 과 latest 를 함께 올림)
APP_TAG=latest
WEB_TAG=latest

# MariaDB root 비밀번호 (앱 컨테이너에는 전달되지 않음)
# - 운영 서버이므로 로컬과 다른, 긴 비밀번호 사용
MARIADB_ROOT_PASSWORD=루트용_긴_비밀번호

# DB 와 앱 전용 계정
# - db/init/01-revoke-drop.sql 이 boot_db, boot 이름을 사용하므로 바꾸면 그 파일도 함께 수정
MARIADB_DATABASE=boot_db
MARIADB_USER=boot
MARIADB_PASSWORD=앱용_비밀번호
