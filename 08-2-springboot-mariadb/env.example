# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요
# - 값에 따옴표("")나 공백을 넣지 마세요 (docker --env-file은 따옴표까지 값으로 인식)
# - $, ", ', 공백 같은 특수문자는 피하는 것이 편합니다
# - MariaDB 컨테이너와 Spring Boot 컨테이너가 이 파일을 함께 사용합니다

# MariaDB root 비밀번호 (DB 관리용, 앱에서는 사용하지 않음)
MARIADB_ROOT_PASSWORD=루트용_긴_비밀번호

# 처음 시작할 때 자동으로 만들어질 DB와 앱 전용 계정
# - db/init/01-revoke-drop.sql이 boot_db, boot 이름을 사용하므로 바꾸면 그 파일도 함께 수정
MARIADB_DATABASE=boot_db
MARIADB_USER=boot
MARIADB_PASSWORD=앱용_비밀번호
